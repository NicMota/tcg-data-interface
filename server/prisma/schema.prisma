generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model card_prices {
  id         Int       @id @default(autoincrement())
  card_id    String
  price_usd  Decimal?  @db.Decimal(10, 4)
  date       DateTime  @db.Date
  created_at DateTime? @default(now()) @db.Timestamp(6)
  cards      cards?    @relation(fields: [card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([card_id, date])
  @@index([date], map: "card_prices_date_idx")
}
model User{
  id  String @id @default(uuid())
  createdAt  DateTime @default(now())
  email String @unique
  name String 
  password String
  isMod Boolean @default(false)
  isAdmin Boolean @default(false)
  emailConfirmed Boolean @default(false)
  favorites Favorite[]
  stockMovements StockMovement[]
}

model cards {
  id               Int           @id @default(autoincrement())
  card_id          String        @unique
  name             String?
  released_at      DateTime?     @db.Date
  scryfall_uri     String?
  mana_cost        String?
  type_line        String?
  colors           String[]
  color_identity   String[]
  foil             Boolean?
  nonfoil          Boolean?
  set_code         String?
  set_name         String?
  set_type         String?
  set_uri          String?
  set_search_uri   String?
  scryfall_set_uri String?
  rarity           String?
  prices           Json?
  related_uri      Json?
  image_uris       Json?
  quality_score  Int            @default(0)
  card_prices      card_prices[]
  favorites        Favorite[]
  inventory        InventoryItem[]
}

model Favorite {
  userId String
  cardId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card cards @relation(fields: [cardId], references: [card_id], onDelete: Cascade)
  @@id([userId, cardId])
}

// One deployment represents one store; all administrators share this inventory.
model InventoryItem {
  id String @id @default(uuid())
  sku String @unique
  cardId String?
  name String
  setCode String @default("")
  condition String @default("NM")
  language String @default("EN")
  finish String @default("nonfoil")
  quantity Int @default(0)
  reserved Int @default(0)
  costBrl Decimal @default(0) @db.Decimal(12, 2)
  priceBrl Decimal @default(0) @db.Decimal(12, 2)
  reorderPoint Int @default(2)
  location String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card cards? @relation(fields: [cardId], references: [card_id], onDelete: SetNull)
  movements StockMovement[]
  @@index([name])
}

model StockMovement {
  id String @id @default(uuid())
  itemId String
  actorId String
  type String
  quantityDelta Int
  reservedDelta Int @default(0)
  quantityAfter Int
  reservedAfter Int
  reason String
  createdAt DateTime @default(now())
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([itemId, createdAt])
}

model StockImport {
  id String @id @default(uuid())
  digest String @unique
  filename String
  rowCount Int
  createdAt DateTime @default(now())
}
